[0.012, "o", "Usage: GocciaBenchmarkRunner [path...|-] [options]\r\n\r\nEngine Options:\r\n  --mode=interpreted|bytecode    Execution mode\r\n  --source-type=script|module    Source loading kind (default: script)\r\n  --asi                          Enable automatic semicolon insertion\r\n  --import-map=<value>           Path to import map JSON file\r\n  --alias <value>                Import alias (e.g. @/=./src/)\r\n  --timeout=<N>                  Per-file timeout in milliseconds\r\n  --max-memory=<N>               GC heap byte limit (RangeError on exceed)\r\n  --max-instructions=<N>         Maximum execution steps before aborting\r\n  --unsafe-ffi                   Enable the FFI global (foreign function interface)\r\n  --unsafe-function-constructor  Enable the Function constructor (dynamic code generation)\r\n  --stack-size=<N>               Maximum call stack depth (0 = no limit)\r\n  --compat-var                   Enable var declarations (compatibility)\r\n  --compat-function              Enable function declarations and expressions (compatibility"]
[0.000, "o", ")\r\n  --strict-types                 Enforce type annotations at runtime (interpreter and bytecode)\r\n  --allowed-host <value>         Hostname allowed for fetch requests (repeatable)\r\n\r\nOptions:\r\n  --no-progress                  Suppress progress output\r\n  --format <value>               Output format (console, text, csv, json, compact-json). \"compact-json\" emits the json envelope without build, memory, stdout, stderr.\r\n  --output=<value>               Output file path (attaches to last --format)\r\n  --help                         Show this help message\r\n  --jobs=<N>                     Number of parallel worker threads\r\n  --log=<value>                  Write console output to a log file\r\n  --config=<value>               Path to a config file or a directory containing one (skips auto-discovery)\r\n"]
